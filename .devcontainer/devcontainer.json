{
  "name": "Dexonomy (CUDA 12.4)",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.devcontainer.yml"
  ],
  "service": "dexonomy",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "overrideCommand": false,
  "initializeCommand": "bash .devcontainer/setup_xauth.sh",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/bin/python",
        "python.terminal.activateEnvironment": false,
        "python.analysis.extraPaths": [
          "/workspace"
        ],
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.exclude": {
          "**/__pycache__": true,
          "**/*.egg-info": true
        }
      }
    }
  },
  "postStartCommand": "python -c \"import torch, mujoco, dexonomy; print('Dexonomy ready | torch', torch.__version__, '| CUDA', torch.cuda.is_available(), '| MuJoCo', mujoco.__version__)\""
}
