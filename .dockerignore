# The archives and extracted datasets are mounted at runtime. Keeping them out
# of the build context makes image builds fast and prevents accidental copies.
data
assets/object
output*
debug*
MUJOCO_LOG.TXT

# BODex is optional and is not required by the standard v3d/vusd visualizers.
third_party/BODex

# MuJoCo Menagerie is large; Dexonomy references only these hand/arm models.
third_party/mujoco_menagerie/*
!third_party/mujoco_menagerie/shadow_hand/
!third_party/mujoco_menagerie/shadow_hand/**
!third_party/mujoco_menagerie/wonik_allegro/
!third_party/mujoco_menagerie/wonik_allegro/**
!third_party/mujoco_menagerie/leap_hand/
!third_party/mujoco_menagerie/leap_hand/**
!third_party/mujoco_menagerie/universal_robots_ur10e/
!third_party/mujoco_menagerie/universal_robots_ur10e/**
